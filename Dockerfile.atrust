# syntax=docker/dockerfile:1
FROM hagb/docker-atrust@sha256:d564515395c2eabdbd78152ad47ea11e6d01a41b94435509ac1b8ddff79ffe26

RUN printf 'deb http://deb.debian.org/debian bookworm main\ndeb http://deb.debian.org/debian-security bookworm-security main\n' > /etc/apt/sources.list && \
    rm -rf /etc/apt/sources.list.d /etc/apt/preferences.d/qemu && \
    apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests xvfb && \
    apt-get purge -y \
        tigervnc-standalone-server \
        tigervnc-tools \
        flwm \
        stalonetray \
        xclip \
        x11-utils \
        libssl-dev \
        wget && \
    apt-get autoremove -y --purge && \
    rm -rf \
        /var/lib/apt/lists/* \
        /var/cache/apt/archives/* \
        /usr/local/bin/novnc \
        /usr/local/bin/novnc-easy-novnc.sh \
        /usr/local/bin/novnc-min-size.sh \
        /usr/local/bin/websockify \
        /usr/local/bin/easy-novnc \
        /usr/local/share/novnc \
        /etc/tinyproxy-novnc.conf \
        /usr/local/bin/get-vnc-clip.sh \
        /usr/local/bin/set-vnc-clip.sh \
        /usr/bin/xdg-open \
        /usr/local/bin/test-libs.sh \
        /usr/local/bin/test-sangfor-libs.sh \
        /usr/local/lib/fake-hwaddr.so \
        /usr/share/sangfor/EasyConnect \
        /tmp/build-scripts \
        /root/.vnc \
        /tmp/* \
        /var/tmp/*

COPY deploy/hziee/atrust_qr.cjs /opt/atrust-web/atrust_qr.cjs
COPY deploy/hziee/atrust_qr.html /opt/atrust-web/atrust_qr.html
COPY deploy/hziee/atrust_qr_entry.cjs /opt/atrust-web/atrust_qr_entry.cjs
COPY deploy/hziee/atrust-scripts/ /usr/local/bin/

RUN cp /usr/share/sangfor/aTrust/resources/app/src/main.js \
       /usr/share/sangfor/aTrust/resources/app/src/main.before-qr.js && \
    cp /opt/atrust-web/atrust_qr_entry.cjs \
       /usr/share/sangfor/aTrust/resources/app/src/main.js && \
    chmod 0644 /opt/atrust-web/atrust_qr.cjs /opt/atrust-web/atrust_qr.html /opt/atrust-web/atrust_qr_entry.cjs && \
    chmod 0755 \
        /usr/local/bin/vpn-config.sh \
        /usr/local/bin/keepalive-ping.sh \
        /usr/local/bin/start-sangfor.sh \
        /usr/local/bin/start.sh

ARG COMMIT_ID=unknown

ENV ATRUST_WEB_PORT=58081 \
    ATRUST_LISTEN_PORT=58081 \
    ATRUST_PUBLIC_PORTS=58081 \
    ATRUST_SOCKS_PORT=1080 \
    PING_ADDR=10.130.10.75 \
    PING_ADDR_URL=http://10.130.10.75/ \
    PING_INTERVAL=60

EXPOSE 1080 8888 58081

LABEL org.opencontainers.image.source="https://github.com/OyamaMeek/HzieeVPN-easyconnect" \
      org.opencontainers.image.revision="${COMMIT_ID}"

CMD ["start.sh"]
